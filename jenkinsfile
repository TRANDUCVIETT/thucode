pipeline {
    agent any
    environment {
        // Cấu hình các biến môi trường nếu cần
        MAVEN_HOME = "C:/apache-maven-3.9.10"  // Đảm bảo đường dẫn Maven là chính xác
    }
    stages {
        // Checkout code từ GitHub
        stage('Checkout') {
            steps {
                git url: 'https://github.com/TRANDUCVIETT/thucode.git', branch: 'main'
            }
        }

        // Build ứng dụng
        stage('Build') {
            steps {
                // Sử dụng lệnh bat để chạy Maven trên Windows
                bat 'mvn clean install'  // Lệnh `bat` thay vì `sh` trên Windows
            }
        }

        // Chạy Test
        stage('Test') {
            steps {
                // Chạy test với Maven
                bat 'mvn test'  // Lệnh `bat` thay vì `sh`
            }
        }

        // Deploy ứng dụng (tùy chọn)
        stage('Deploy') {
            steps {
                // Ví dụ nếu bạn triển khai với script deploy.bat
                bat 'deploy.bat'  // Thay `sh './deploy.sh'` bằng `bat 'deploy.bat'` cho Windows
            }
        }
    }

    post {
        always {
            // Các thao tác sau khi pipeline hoàn thành (ví dụ: gửi thông báo hoặc lưu trữ logs)
            echo "Pipeline execution completed."
        }
        success {
            // Thực hiện hành động nếu pipeline thành công
            echo "Build and deployment were successful."
        }
        failure {
            // Thực hiện hành động nếu pipeline thất bại
            echo "Build or deployment failed."
        }
    }
} l